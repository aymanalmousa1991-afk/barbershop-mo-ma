# ===== Barbershop Mo&Ma - Environment Configuratie =====

# API URL (laat leeg voor productie, /api via Vite proxy)
VITE_API_URL=

# Server configuratie
PORT=3001
NODE_ENV=development

# JWT Secret (wijzig dit in productie!)
JWT_SECRET=barbershop-mo-ma-secret-key-2024

# Email configuratie (SMTP)
# Voor Gmail: genereer een App Password op https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Mo&Ma Kapsalon <info@barbershop-moma.nl>

# Cron job voor reminders (elke 30 minuten)
REMINDER_CRON_SCHEDULE=*/30 * * * *

# Database pad (standaard: ./server/barbershop.db)
DATABASE_PATH=
